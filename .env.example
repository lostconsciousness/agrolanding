# Paddle.js live checkout. These NEXT_PUBLIC values are intentionally readable
# by the browser; never put a server-side Paddle API key in a NEXT_PUBLIC value.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_replace_with_client_side_token

# Live recurring prices. Create one monthly and one yearly price per product.
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=pri_replace_with_starter_monthly_price_id
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=pri_replace_with_starter_yearly_price_id
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_replace_with_pro_monthly_price_id
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=pri_replace_with_pro_yearly_price_id
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=pri_replace_with_advanced_monthly_price_id
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=pri_replace_with_advanced_yearly_price_id

# Optional backwards-compatible yearly aliases used by the original landing page.
NEXT_PUBLIC_PADDLE_PRICE_BASIC=pri_replace_with_starter_yearly_price_id
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=pri_replace_with_pro_yearly_price_id
NEXT_PUBLIC_PADDLE_PRICE_MAX=pri_replace_with_advanced_yearly_price_id

# Server-only secret for POST /api/paddle/webhook. Never prefix this with NEXT_PUBLIC_.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_with_endpoint_secret
