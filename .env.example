# Paddle.js: safe client-side values used by the pricing buttons.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace_with_client_side_token
NEXT_PUBLIC_PADDLE_PRICE_BASIC=pri_replace_with_basic_price_id
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=pri_replace_with_business_price_id
NEXT_PUBLIC_PADDLE_PRICE_MAX=pri_replace_with_max_price_id

# Server-only secret for POST /api/paddle/webhook. Never prefix this with NEXT_PUBLIC_.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_with_endpoint_secret
