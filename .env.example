# Paddle.js live checkout. These NEXT_PUBLIC values are intentionally readable
# by the browser; never put a server-side Paddle API key in a NEXT_PUBLIC value.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_replace_with_client_side_token

# Live annual recurring prices. The product names are CORE BASIC,
# CORE BUSINESS and CORE MAX. Monthly prices are not used by the site.
NEXT_PUBLIC_PADDLE_PRICE_BASIC=pri_replace_with_basic_annual_price_id
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=pri_replace_with_business_annual_price_id
NEXT_PUBLIC_PADDLE_PRICE_MAX=pri_replace_with_max_annual_price_id

# Server-only Paddle values. Never prefix these with NEXT_PUBLIC_.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=pdl_live_apikey_replace_with_server_side_api_key
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_replace_with_notification_destination_secret

# Legacy alias accepted by the webhook during migration.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_with_notification_destination_secret

# AI and email sign-in: SERVER ONLY. Set these as Worker secrets, never NEXT_PUBLIC.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_GUARD_MODEL=gpt-4.1-mini
# Optional curated agriculture documents uploaded to an OpenAI vector store.
OPENAI_AGRO_VECTOR_STORE_ID=
AI_DAILY_MESSAGE_LIMIT=40
RESEND_API_KEY=
# Must use your verified sending domain, e.g. CORE AGRO <login@core-agro.com>
AUTH_FROM_EMAIL=
# Generate a random secret with: openssl rand -hex 32
AUTH_SECRET=
